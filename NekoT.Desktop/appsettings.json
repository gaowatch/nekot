{
  "Application": {
    "Name": "NekoT",
    "Version": "0.1.0"
  },
  "WebView2": {
    "BackgroundColor": "#FFFFFF"
  },
  "Network": {
    "LocalEndpoint": "http://127.0.0.1:8787/v1/chat/completions",
    "DefaultTimeoutSeconds": 100,
    "MaxRetryCount": 3
  },
  "TokenManagement": {
    "MaxRecordCount": 1000,
    "DeduplicationCacheSize": 100
  },
  "Storage": {
    "AppDataFolderName": "NekoT",
    "SecureStorageFileName": "secure.dat",
    "KeyFileName": "nekot.key",
    "DatabaseFileName": "nekot.db",
    "LogFileName": "nekot.log"
  },
  "Security": {
    "AesKeySize": 32,
    "NonceSize": 12,
    "TagSize": 16,
    "IvSize": 16
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "NekoT": "Information"
    }
  },
  "ProviderUrls": {
    "minimax": "https://api.minimaxi.com/v1/text/chatcompletion_v2",
    "minimaxi": "https://api.minimaxi.com/v1/text/chatcompletion_v2",
    "gpt": "https://api.openai.com/v1/chat/completions",
    "claude": "https://api.anthropic.com/v1/messages",
    "openai": "https://api.openai.com/v1/chat/completions",
    "deepseek": "https://api.deepseek.com/v1/chat/completions",
    "moonshot": "https://api.moonshot.cn/v1/chat/completions",
    "zhipu": "https://open.bigmodel.cn/api/paas/v4/chat/completions"
  },
  "Update": {
    "Url": "https://github.com/gaowatch/nekot/releases",
    "CheckIntervalHours": 24,
    "ForceUpdateApi": ""
  }
}
